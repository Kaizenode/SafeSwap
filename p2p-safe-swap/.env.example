# Sentry error tracking (DSN is public — it only allows writing events, not reading them)
NEXT_PUBLIC_SENTRY_DSN=

# Used at build time only, to upload source maps to Sentry. Never commit a real token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Secret used to sign the SafeSwap wallet session cookie.
SESSION_SECRET=

# ── Supabase (see docs/SUPABASE-SETUP.md) ────────────────────────────────
# Dev project: safeswap-dev · Prod project: safeswap-prod.
# URLs/keys live in 1Password under "SafeSwap — Supabase".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
