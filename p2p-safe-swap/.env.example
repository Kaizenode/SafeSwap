# Supabase — see docs/SUPABASE-SETUP.md for setup instructions.
# The dev/prod projects (safeswap-dev / safeswap-prod) and their keys are
# recorded in 1Password. Copy this file to .env.local and fill in real values.

# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose this to the client:
SUPABASE_SERVICE_ROLE_KEY=
